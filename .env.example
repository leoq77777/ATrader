# ==============================================================================
# ATrader - The Karpathy Ratchet Agent Trader Configuration
# Copy this file to .env and fill in the keys you use:
#   cp .env.example .env
# ==============================================================================

# 1. LLM Model API (Default: DeepSeek OpenAI-Compatible API)
# Docs: https://api-docs.deepseek.com/
LLM_API_KEY=your_deepseek_api_key_here
LLM_BASE_URL=https://api.deepseek.com
# Recommended models:
# - deepseek-chat / deepseek-flash (Ultra-low cost for frequent signal/code iteration)
# - deepseek-reasoner / deepseek-v4-pro (Deep reasoning for complex strategy evolution)
LLM_MODEL=deepseek-chat
LLM_COST_INPUT_PER_1M=0.27
LLM_COST_OUTPUT_PER_1M=1.10

# 2. Ratchet Engine Mode
# Options:
#   code_ratchet   -> LLM evolves strategy.py offline; live trading uses 0 tokens (Best ROI)
#   signal_ratchet -> LLM outputs low-freq regime/position signals; weighted by shadow win-rate ratchet
#   hybrid         -> Combines code_ratchet execution with low-freq signal_ratchet regime filter (Recommended)
RATCHET_MODE=hybrid

# 3. Active Trading Brokers (comma-separated: local_paper,alpaca,ccxt,longbridge)
ACTIVE_BROKERS=local_paper

# 4. Alpaca Trading API (US Stocks, ETFs & Crypto)
# Docs: https://docs.alpaca.markets/us/docs/trading-api
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Use https://paper-api.alpaca.markets for free Paper Trading, or https://api.alpaca.markets for Live
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# 5. CCXT Crypto Exchange API (Binance / OKX / Bybit / Coinbase)
# Docs: https://docs.ccxt.com/
CCXT_EXCHANGE=binance
CCXT_API_KEY=
CCXT_SECRET_KEY=
CCXT_PASSWORD=
CCXT_SANDBOX=true

# 6. Longbridge (LongPort) OpenAPI (HK & US Equities)
# Docs: https://open.longbridge.com/docs/getting-started
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=

# 7. Capital & Risk Guardrails
INITIAL_PAPER_CASH=10000.0
MAX_POSITION_PCT=0.25
MAX_DAILY_DRAWDOWN_PCT=0.05
TRADING_FEE_BPS=5.0
SLIPPAGE_BPS=3.0
